:root {
    --primary: #ff4655;
    --secondary: #00d4ff;
    --dark: #0a0e27;
    --darker: #050816;
    --success: #00ff88;
    --warning: #ffc107;
    --danger: #ff1744;
    --text: #e0e6f7;
    --text-dim: #8b93b8;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Rajdhani', sans-serif;
    background: var(--darker);
    color: var(--text);
    overflow-x: hidden;
    min-height: 100vh;
}

/* Animated Background */
.bg-animated {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    background: 
        radial-gradient(circle at 20% 80%, rgba(255, 70, 85, 0.15) 0%, transparent 50%),
        radial-gradient(circle at 80% 20%, rgba(0, 212, 255, 0.15) 0%, transparent 50%),
        radial-gradient(circle at 50% 50%, rgba(0, 255, 136, 0.08) 0%, transparent 50%);
    animation: bgPulse 15s ease-in-out infinite;
}

@keyframes bgPulse {
    0%, 100% { opacity: 0.6; }
    50% { opacity: 1; }
}

.grid-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
        linear-gradient(rgba(255, 70, 85, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 70, 85, 0.03) 1px, transparent 1px);
    background-size: 50px 50px;
    z-index: 0;
}

.container {
    position: relative;
    z-index: 1;
    max-width: 1400px;
    margin: 0 auto;
    padding: 20px;
}

/* Header */
header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 0;
    margin-bottom: 40px;
    border-bottom: 2px solid rgba(255, 70, 85, 0.2);
}

.logo {
    display: flex;
    align-items: center;
    gap: 15px;
    font-family: 'Orbitron', sans-serif;
    font-size: 28px;
    font-weight: 900;
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-transform: uppercase;
    letter-spacing: 3px;
    animation: logoGlow 3s ease-in-out infinite;
}

.logo-img {
    height: 50px;
    width: auto;
}

@keyframes logoGlow {
    0%, 100% { filter: drop-shadow(0 0 10px rgba(255, 70, 85, 0.5)); }
    50% { filter: drop-shadow(0 0 20px rgba(255, 70, 85, 0.8)); }
}

.user-info {
    display: flex;
    align-items: center;
    gap: 20px;
}

.status-badge {
    padding: 8px 20px;
    border-radius: 25px;
    font-weight: 600;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.status-free {
    background: rgba(255, 23, 68, 0.2);
    color: var(--danger);
    border: 2px solid var(--danger);
}

.status-active {
    background: rgba(0, 255, 136, 0.2);
    color: var(--success);
    border: 2px solid var(--success);
    animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(0, 255, 136, 0.7); }
    50% { box-shadow: 0 0 0 10px rgba(0, 255, 136, 0); }
}

.btn {
    padding: 12px 30px;
    border: none;
    border-radius: 8px;
    font-family: 'Orbitron', sans-serif;
    font-weight: 700;
    font-size: 14px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
    letter-spacing: 1px;
}

.btn-primary {
    background: linear-gradient(135deg, var(--primary), #ff1744);
    color: white;
    box-shadow: 0 8px 25px rgba(255, 70, 85, 0.4);
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 35px rgba(255, 70, 85, 0.6);
}

.btn-secondary {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text);
    border: 2px solid rgba(255, 255, 255, 0.1);
}

.btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.3);
}

/* Main Grid */
.main-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 30px;
    margin-bottom: 30px;
}

@media (max-width: 968px) {
    .main-grid {
        grid-template-columns: 1fr;
    }
}

.card {
    background: rgba(255, 255, 255, 0.02);
    backdrop-filter: blur(10px);
    border-radius: 20px;
    padding: 30px;
    border: 2px solid rgba(255, 255, 255, 0.05);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
}

.card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
    padding-bottom: 15px;
    border-bottom: 2px solid rgba(255, 255, 255, 0.1);
}

.card-title {
    font-family: 'Orbitron', sans-serif;
    font-size: 24px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--primary);
}

/* Aviator Game Display */
.game-display {
    position: relative;
    background: linear-gradient(135deg, rgba(0, 10, 30, 0.8), rgba(10, 14, 39, 0.8));
    border-radius: 15px;
    padding: 40px;
    text-align: center;
    min-height: 400px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    border: 2px solid rgba(255, 70, 85, 0.3);
    overflow: hidden;
}

.game-display::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgba(0, 212, 255, 0.03) 2px,
        rgba(0, 212, 255, 0.03) 4px
    );
    animation: scanline 10s linear infinite;
}

@keyframes scanline {
    0% { transform: translateY(0); }
    100% { transform: translateY(50%); }
}

.plane-container {
    position: relative;
    z-index: 1;
    margin-bottom: 20px;
}

.plane-icon {
    width: 200px;
    height: auto;
    animation: planeFly 3s ease-in-out infinite;
    filter: drop-shadow(0 0 30px rgba(255, 70, 85, 0.8));
}

@keyframes planeFly {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(-5deg); }
}

.multiplier-display {
    position: relative;
    z-index: 1;
    font-family: 'Orbitron', sans-serif;
    font-size: 72px;
    font-weight: 900;
    background: linear-gradient(135deg, var(--success), var(--secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 10px;
    animation: multiplierPulse 1s ease-in-out infinite;
}

@keyframes multiplierPulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
}

.game-status {
    position: relative;
    z-index: 1;
    font-size: 18px;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 2px;
}

/* Signal Panel */
.signal-panel {
    background: linear-gradient(135deg, rgba(255, 70, 85, 0.1), rgba(0, 212, 255, 0.1));
    border-radius: 15px;
    padding: 25px;
    margin-top: 20px;
}

.signal-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    margin-bottom: 15px;
    background: rgba(255, 255, 255, 0.02);
    border-radius: 12px;
    border-left: 4px solid var(--secondary);
    transition: all 0.3s ease;
}

.signal-item:hover {
    background: rgba(255, 255, 255, 0.05);
    transform: translateX(5px);
}

.signal-info {
    flex: 1;
}

.signal-type {
    font-family: 'Orbitron', sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: var(--secondary);
    margin-bottom: 5px;
}

.signal-value {
    font-size: 32px;
    font-weight: 900;
    font-family: 'Orbitron', sans-serif;
    color: var(--success);
}

.signal-confidence {
    display: inline-block;
    padding: 5px 15px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    background: rgba(0, 255, 136, 0.2);
    color: var(--success);
}

/* History Table */
.history-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
}

.history-table th {
    text-align: left;
    padding: 15px;
    font-family: 'Orbitron', sans-serif;
    font-weight: 700;
    color: var(--primary);
    text-transform: uppercase;
    font-size: 12px;
    letter-spacing: 1px;
    border-bottom: 2px solid rgba(255, 70, 85, 0.3);
}

.history-table td {
    padding: 15px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 16px;
}

.history-table tr:hover {
    background: rgba(255, 255, 255, 0.02);
}

.result-badge {
    display: inline-block;
    padding: 5px 12px;
    border-radius: 15px;
    font-weight: 700;
    font-size: 14px;
}

.result-win {
    background: rgba(0, 255, 136, 0.2);
    color: var(--success);
}

.result-loss {
    background: rgba(255, 23, 68, 0.2);
    color: var(--danger);
}

/* Payment Modal */
.modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(10px);
    z-index: 1000;
    justify-content: center;
    align-items: center;
}

.modal.active {
    display: flex;
}

.modal-content {
    position: relative;
    background: var(--dark);
    border-radius: 20px;
    padding: 40px;
    max-width: 500px;
    width: 90%;
    border: 2px solid rgba(255, 70, 85, 0.3);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    animation: modalSlideIn 0.4s ease-out;
}

@keyframes modalSlideIn {
    from {
        opacity: 0;
        transform: translateY(-50px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.modal-header {
    text-align: center;
    margin-bottom: 30px;
}

.modal-title {
    font-family: 'Orbitron', sans-serif;
    font-size: 28px;
    font-weight: 900;
    color: var(--primary);
    margin-bottom: 10px;
}

.payment-info {
    background: rgba(255, 255, 255, 0.03);
    border-radius: 15px;
    padding: 25px;
    margin-bottom: 25px;
}

.payment-field {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.payment-field:last-child {
    border-bottom: none;
}

.payment-label {
    color: var(--text-dim);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.payment-value {
    font-family: 'Orbitron', sans-serif;
    font-size: 24px;
    font-weight: 700;
    color: var(--secondary);
}

.close-modal {
    position: absolute;
    top: 20px;
    right: 20px;
    background: none;
    border: none;
    color: var(--text);
    font-size: 30px;
    cursor: pointer;
    transition: all 0.3s ease;
}

.close-modal:hover {
    color: var(--primary);
    transform: rotate(90deg);
}

/* Admin Panel */
.admin-panel {
    display: none;
    background: rgba(255, 255, 255, 0.02);
    border-radius: 20px;
    padding: 30px;
    margin-top: 30px;
    border: 2px solid rgba(0, 255, 136, 0.3);
}

.admin-panel.active {
    display: block;
    animation: fadeIn 0.5s ease-in;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
}

.users-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
    margin-top: 20px;
}

.user-card {
    background: rgba(255, 255, 255, 0.03);
    border-radius: 12px;
    padding: 20px;
    border: 2px solid rgba(255, 255, 255, 0.1);
    transition: all 0.3s ease;
}

.user-card:hover {
    border-color: var(--secondary);
    transform: translateY(-5px);
}

.user-card h3 {
    color: var(--secondary);
    margin-bottom: 15px;
    font-family: 'Orbitron', sans-serif;
}

.user-actions {
    display: flex;
    gap: 10px;
    margin-top: 15px;
}

.btn-approve {
    background: var(--success);
    color: var(--darker);
    flex: 1;
}

.btn-reject {
    background: var(--danger);
    color: white;
    flex: 1;
}

/* Stats Cards */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    margin-bottom: 30px;
}

.stat-card {
    background: linear-gradient(135deg, rgba(255, 70, 85, 0.1), rgba(0, 212, 255, 0.1));
    border-radius: 15px;
    padding: 25px;
    text-align: center;
    border: 2px solid rgba(255, 255, 255, 0.05);
    transition: all 0.3s ease;
}

.stat-card:hover {
    transform: translateY(-5px);
    border-color: var(--secondary);
}

.stat-value {
    font-family: 'Orbitron', sans-serif;
    font-size: 36px;
    font-weight: 900;
    color: var(--success);
    margin-bottom: 5px;
}

.stat-label {
    color: var(--text-dim);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* Login Form */
.login-container {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.95);
    backdrop-filter: blur(10px);
    z-index: 2000;
    justify-content: center;
    align-items: center;
}

.login-container.active {
    display: flex;
}

.login-box {
    background: var(--dark);
    border-radius: 20px;
    padding: 50px;
    max-width: 400px;
    width: 90%;
    border: 2px solid rgba(255, 70, 85, 0.3);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.7);
}

.login-title {
    font-family: 'Orbitron', sans-serif;
    font-size: 32px;
    font-weight: 900;
    text-align: center;
    margin-bottom: 30px;
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.form-group {
    margin-bottom: 20px;
}

.form-label {
    display: block;
    color: var(--text-dim);
    font-size: 14px;
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.form-input {
    width: 100%;
    padding: 15px;
    background: rgba(255, 255, 255, 0.05);
    border: 2px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: var(--text);
    font-size: 16px;
    font-family: 'Rajdhani', sans-serif;
    transition: all 0.3s ease;
}

.form-input:focus {
    outline: none;
    border-color: var(--secondary);
    background: rgba(255, 255, 255, 0.08);
}

.alert {
    padding: 15px;
    border-radius: 8px;
    margin-bottom: 20px;
    text-align: center;
    font-weight: 600;
}

.alert-success {
    background: rgba(0, 255, 136, 0.2);
    color: var(--success);
    border: 2px solid var(--success);
}

.alert-danger {
    background: rgba(255, 23, 68, 0.2);
    color: var(--danger);
    border: 2px solid var(--danger);
}

.alert-info {
    background: rgba(0, 212, 255, 0.2);
    color: var(--secondary);
    border: 2px solid var(--secondary);
}

/* Locked Content Overlay */
.locked-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(10, 14, 39, 0.95);
    backdrop-filter: blur(20px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    z-index: 10;
    border-radius: 15px;
}

.lock-icon {
    margin-bottom: 20px;
    animation: lockShake 2s ease-in-out infinite;
}

.lock-icon svg {
    stroke: var(--danger);
    stroke-width: 2;
}

@keyframes lockShake {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(-5deg); }
    75% { transform: rotate(5deg); }
}

.lock-message {
    font-size: 24px;
    font-weight: 700;
    text-align: center;
    margin-bottom: 30px;
    color: var(--text);
}

/* Responsive */
@media (max-width: 768px) {
    .logo {
        font-size: 20px;
    }

    .logo-img {
        height: 40px;
    }

    .multiplier-display {
        font-size: 48px;
    }

    .plane-icon {
        width: 120px;
    }

    header {
        flex-direction: column;
        gap: 20px;
        text-align: center;
    }

    .user-info {
        flex-direction: column;
        width: 100%;
    }

    .btn {
        width: 100%;
    }
}
